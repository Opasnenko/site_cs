<div class="adm-table-wrap">
	<div class="adm-table-head">
		<span class="adm-table-head__icon"><span class="glyphicon glyphicon-hdd"></span></span>
		<span class="adm-table-head__name">{name}</span>
	</div>
	<div class="adm-table-scroll">
		<table class="adm-table" id="server_admins">
			<thead>
				<tr>
					<th class="adm-table__num">#</th>
					<th>Пользователь</th>
					<th>Идентификатор</th>
					<th>Услуги</th>
					<th>Окончание</th>
					<th class="adm-table__actions">Действия</th>
				</tr>
			</thead>
			<tbody>
				{admins}
			</tbody>
		</table>
	</div>
</div>
