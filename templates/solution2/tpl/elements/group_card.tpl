<div class="pbg-group-card{active_class}" data-group-id="{id}">
  <span class="pbg-group-card_dot" style="background:{color};box-shadow:0 0 12px {color}66;"></span>
  <div class="pbg-group-card_text">
    <span class="pbg-group-card_name">{name}</span>
    <span class="pbg-group-card_status">{status_text}</span>
  </div>
  {action_html}
</div>
