<head>
    <meta charset="utf-8">
    <title>{title}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="robots" content="{robots}">
    <meta name="revisit" content="1">
    <meta name="description" content="{description}">
    <meta name="keywords" content="{keywords}">
    <meta name="document-state" content="dynamic">
    <meta name="author" content="PBGame CMS">

    <meta property="og:title" content="{title}">
    <meta property="og:description" content="{description}">
    <meta property="og:type" content="{type}">
    <meta property="og:image" content="{image}?v={cache}">
    <meta property="og:site_name" content="{site_name}">
    <meta property="og:url" content="{url}">

    <meta name="dc.title" content="{title}">
    <meta name="dc.rights" content="Copyright PBGame CMS. Все права защищены.">
    <meta name="dc.creator" content="PBGame CMS">
    <meta name="dc.language" content="RU">

    <link rel="canonical" href="{site_name}">
    <link rel="image_src" href="{image}">
    <link rel="shortcut icon" href="{site_host}templates/admin/img/logonew.png?v={cache}">

    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_fonts.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_boxicons.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/fonts/font-awesome.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/fonts/stylesheet.css?v={cache}">

    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_bootstrap.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_main.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_style_1.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_style_2.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_style_3.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg/pbg_style_4.css?v={cache}">

    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_preloader.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_auth.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_menu.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_float-bar.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_chat-redesign.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_smiles.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_monik_new.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_pb_slider.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_market.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_p2p.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_my-stores-modern.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_premium.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_settings.css?v={cache}">
    <link rel="stylesheet" href="{site_host}ajax/addons/toasts/pb-toast.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_cookie-consent.css?v={cache}">
    <link rel="stylesheet" href="{site_host}templates/{template}/css/modules/pbg_mob.css?v={cache}">

    <link rel="stylesheet" href="{site_host}templates/{template}/css/pbg_my_style.css?v={cache}">

    <script src="{site_host}templates/{template}/js/jquery.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/bootstrap.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/slick.min.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/nprogress.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/mix.js?v={cache}"></script>

    <script src="{site_host}ajax/performers/functions.min.js?v={cache}"></script>
    <script src="{site_host}ajax/performers/main.min.js?v={cache}"></script>

    <script src="{site_host}templates/{template}/js/auth-compat.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/mst-stores.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pb-notify-cards.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pb-notifications.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pb-hero-video.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg_smiles.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg-menu.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg-notif-drawer.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg-profile-drawer.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg-perf-mode.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg-promo-modal.js?v={cache}"></script>
    <script src="{site_host}templates/{template}/js/pbg-float-bar.js?v={cache}"></script>

    <script src="{site_host}ajax/addons/toasts/pb-toast.js?v={cache}" defer></script>
    <script src="{site_host}templates/{template}/js/cookie-consent.js?v={cache}" defer></script>
    <script src="{site_host}templates/{template}/js/pb-media-lazy.js?v={cache}" defer></script>
    <script src="{site_host}templates/{template}/js/pb_slider.js?v={cache}" defer></script>

    {files}
    {other}
</head>

<body{body_style}>
    <script src="{site_host}templates/{template}/js/pbg-perf-mode-boot.js?v={cache}"></script>

    <div class="pb-preloader">
      <span class="pb-preloader__label">Загрузка</span>
      <div class="pb-preloader__core">
        <span class="pb-preloader__glow"></span>
        <span class="pb-preloader__ring pb-preloader__ring--outer"></span>
        <span class="pb-preloader__ring pb-preloader__ring--inner"></span>
        <span class="pb-preloader__dot"></span>
      </div>
    </div>
    <script src="{site_host}templates/{template}/js/pb-preloader.js?v={cache}"></script>

    <input id="token" type="hidden" value="{token}">
